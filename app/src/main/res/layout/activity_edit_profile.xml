<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- ═══ TOP BAR: Cancel | Edit profile | Save ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/page_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/edit_profile"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="@string/save"
            android:textColor="@color/text_tertiary"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <!-- ═══ PROFILE PHOTO ═══ -->
            <FrameLayout
                android:id="@+id/profilePicContainer"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/editProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/surface_muted"
                    android:padding="1dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Circle"
                    app:strokeColor="@color/stroke_strong"
                    app:strokeWidth="1dp" />

                <ImageView
                    android:id="@+id/cameraOverlayIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_camera_overlay"
                    android:contentDescription="@string/edit_profile_picture"
                    android:padding="7dp"
                    android:src="@drawable/ic_camera_white" />
            </FrameLayout>

            <TextView
                android:id="@+id/changePhotoText"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/change_photo"
                android:textColor="@color/accent_text"
                android:textSize="14sp" />

            <!-- ═══ PROFILE ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/profile"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/displayNameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/display_name"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/displayNameValueText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="@string/your_name"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═══ SPENDING CARD ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/spending_card"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/how_the_total_spent_card_looks_on_your_h"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <!-- Size: Standard | Expanded -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/sizeStandardPill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/standard"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sizeExpandedPill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_plain"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/expanded"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Live preview: looks like the real home card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="18dp">

                <FrameLayout
                    android:id="@+id/cardPreviewBox"
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:background="@drawable/bg_total_summary"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/cardPreviewImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/card_preview"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/cardPreviewOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#99000000"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="18dp">

                        <TextView
                            android:id="@+id/previewTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_spent_this_month"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/previewAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="RM 0.00"
                            android:textAppearance="@style/TextAppearance.App.Hero"
                            android:textColor="@color/brand_blue" />

                        <TextView
                            android:id="@+id/previewBudget"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/of_rm_0_00_budget"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/previewProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="0" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_pill"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="@string/preview"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Own photo actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/uploadCardButton"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/upload_your_own"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_gallery"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/removeCardButton"
                    style="@style/Widget.App.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="18dp"
                    android:text="@string/remove"
                    android:textColor="@color/danger_red"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ═══ READY-MADE BACKGROUNDS (2 × 2) ═══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/ready_made_backgrounds"
                android:textAppearance="@style/TextAppearance.App.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tap_one_to_use_it"
                android:textAppearance="@style/TextAppearance.App.Caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/preset1"
                    android:layout_width="0dp"
                    android:layout_height="98dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/preset1Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/background_1"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/card_preset_1"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp" />

                    <ImageView
                        android:id="@+id/preset1Check"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="7dp"
                        android:background="@drawable/bg_check_badge"
                        android:contentDescription="@string/selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/preset2"
                    android:layout_width="0dp"
                    android:layout_height="98dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/preset2Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/background_2"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/card_preset_2"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp" />

                    <ImageView
                        android:id="@+id/preset2Check"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="7dp"
                        android:background="@drawable/bg_check_badge"
                        android:contentDescription="@string/selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/preset3"
                    android:layout_width="0dp"
                    android:layout_height="98dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/preset3Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/background_3"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/card_preset_3"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp" />

                    <ImageView
                        android:id="@+id/preset3Check"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="7dp"
                        android:background="@drawable/bg_check_badge"
                        android:contentDescription="@string/selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/preset4"
                    android:layout_width="0dp"
                    android:layout_height="98dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/preset4Image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/background_4"
                        android:padding="1dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/card_preset_4"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerSize12"
                        app:strokeColor="@color/stroke"
                        app:strokeWidth="1dp" />

                    <ImageView
                        android:id="@+id/preset4Check"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="7dp"
                        android:background="@drawable/bg_check_badge"
                        android:contentDescription="@string/selected"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
