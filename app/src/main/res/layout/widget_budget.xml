<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen widget (4 x 2). Colours, background picture and the bar are
     set from BudgetWidget so they follow the app's Day / Night choice. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Card picture (or plain card colour), rounded, drawn in code -->
    <ImageView
        android:id="@+id/widgetBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- "BudgetFY · November"            "17 days left" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#6B6B6B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widgetDaysLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#9E9E9E"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetSpent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="RM 0.00"
            android:textColor="#1A1A1A"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widgetBudgetLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6B6B6B"
            android:textSize="12sp" />

        <!-- Budget bar, drawn in code at the widget's width -->
        <ImageView
            android:id="@+id/widgetBar"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <LinearLayout
            android:id="@+id/widgetBottomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <!-- Opens the Scan receipt page -->
            <LinearLayout
                android:id="@+id/widgetScanButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_btn_day"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widgetScanIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scan" />

                <TextView
                    android:id="@+id/widgetScanText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/scan_receipt"
                    android:textColor="#0078CC"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widgetLast"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_widget_chip_day"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:maxWidth="160dp"
                android:paddingHorizontal="10dp"
                android:textColor="#555555"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
