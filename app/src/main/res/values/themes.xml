<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: slim, flat, one blue accent -->
    <style name="Theme.BudgetFY" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorSecondaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- Status/navigation bars blend into the page instead of a solid blue band -->
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:navigationBarColor">@color/card_bg</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/page_bg</item>

        <!-- Shapes: small = buttons/inputs, medium = cards -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>

        <!-- Component defaults -->
        <item name="materialCardViewStyle">@style/Widget.App.Card</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.App.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.App.LinearProgress</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
        <item name="autoCompleteTextViewStyle">@style/Widget.App.AutoComplete</item>
    </style>

    <!-- ═══ Dialogs: rounded, calm title, sentence-case buttons ═══ -->
    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorSecondary">@color/brand_blue</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.App.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.App.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButton.Cancel</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.DialogButton.Danger</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
    </style>

    <style name="ShapeAppearance.App.Dialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="MaterialAlertDialog.App.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="MaterialAlertDialog.App.Body" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.App.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <style name="Widget.App.DialogButton.Cancel">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Neutral button is used for "Delete" -->
    <style name="Widget.App.DialogButton.Danger">
        <item name="android:textColor">@color/danger_red</item>
    </style>

    <!-- Dropdown list: rounded bordered card, opens just below the field -->
    <style name="Widget.App.AutoComplete" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:dropDownVerticalOffset">6dp</item>
    </style>

    <!-- ═══ Shapes ═══ -->
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Custom card corners (kept: referenced by existing layouts) -->
    <style name="ShapeAppearanceOverlay.App.CornerSize20" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CornerSize12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Circle shape for profile avatar -->
    <style name="ShapeAppearanceOverlay.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ═══ Components ═══ -->

    <!-- Flat white card with a hairline border, no shadow -->
    <style name="Widget.App.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Medium</item>
    </style>

    <!-- Flat filled button -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Small</item>
    </style>

    <!-- Hairline outlined button -->
    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/stroke_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/card_bg</item>
        <item name="rippleColor">@color/surface_muted</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Small</item>
    </style>

    <!-- Text-only button -->
    <style name="Widget.App.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <!-- Outlined text field with soft corners -->
    <style name="Widget.App.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_blue</item>
        <item name="boxBackgroundColor">@color/card_bg</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/accent_text</item>
    </style>

    <style name="Widget.App.TextInput.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand_blue</item>
        <item name="boxBackgroundColor">@color/card_bg</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="hintTextColor">@color/accent_text</item>
    </style>

    <!-- White toolbar that blends with the page; dark title and icons -->
    <style name="Widget.App.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/page_bg</item>
        <item name="titleTextAppearance">@style/TextAppearance.App.ToolbarTitle</item>
        <item name="titleTextColor">@color/text_primary</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="ThemeOverlay.AppCompat.Light">
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <!-- Slim rounded progress bar -->
    <style name="Widget.App.LinearProgress" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="trackThickness">6dp</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="indicatorColor">@color/brand_blue</item>
        <item name="trackColor">@color/progress_track</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/card_bg</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/bottom_nav_tint</item>
        <item name="itemTextColor">@color/bottom_nav_tint</item>
        <item name="itemIconSize">22dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemRippleColor">@color/surface_muted</item>
    </style>

    <!-- ═══ Typography ═══ -->
    <style name="TextAppearance.App.ToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Big headline number, e.g. RM 267.63 -->
    <style name="TextAppearance.App.Hero" parent="">
        <item name="android:textSize">36sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- Section/card titles: medium weight, not bold -->
    <style name="TextAppearance.App.Title" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Small uppercase-free label above stat numbers -->
    <style name="TextAppearance.App.StatLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.App.StatValue" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/accent_text</item>
    </style>

    <!-- Pill chip text (filters, range selector) -->
    <style name="Widget.App.Pill" parent="">
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
